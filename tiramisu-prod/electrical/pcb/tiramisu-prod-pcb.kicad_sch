	(text "Mounting holes (spec section 8, Developer 2026-11-24): 8 edge holes + 1 centre support, all non-plated.\nNylon or acetal screws; unplated-brass inserts only at the edge; nothing metal under the array.\nH1-H8: M3, hole 3.2 mm, copper keep-out 7 mm. H9: M2 cheese head, hole 2.2 mm, keep-out 5 mm.\nPositions (board mm): H1 (-87.5,-66.25)  H2 (91.5,-66.25)  H3 (-87.5,81.75)  H4 (91.5,81.75)\nH5 (4.25,-66.25)  H6 (4.25,81.75) beside USB-C  H7 (-87.5,-8.5)  H8 (91.5,-8.5)  H9 (4.25,-8.5)"
		(exclude_from_sim no)
		(at 160.02 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3803ae27-cc85-4ba8-8f93-580ab50bca57")
